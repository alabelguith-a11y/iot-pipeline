{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SensorReading",
  "description": "Single source of truth for the message contract. Simulator, firmware, bridge, consumer and SQL staging must all match it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["reading_id", "device_id", "ts", "temperature_c", "humidity_pct"],
  "properties": {
    "reading_id":    {"type": "string", "minLength": 8, "maxLength": 64, "description": "Unique per reading; used for idempotent loads"},
    "device_id":     {"type": "string", "minLength": 3, "maxLength": 32},
    "ts":            {"type": "string", "description": "Event time, ISO-8601 UTC, e.g. 2026-01-01T10:00:00Z"},
    "temperature_c": {"type": "number", "minimum": -80, "maximum": 125, "description": "Physical sensor range (business plausibility is checked later in staging)"},
    "humidity_pct":  {"type": "number", "minimum": -5, "maximum": 105},
    "pressure_hpa":  {"type": "number", "minimum": 300, "maximum": 1100},
    "battery_v":     {"type": "number", "minimum": 0, "maximum": 5},
    "fw_version":    {"type": "string", "maxLength": 16}
  }
}
